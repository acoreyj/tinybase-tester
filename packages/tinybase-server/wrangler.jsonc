/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tinybase-server-with-auth",
	"main": "src/index.ts",
	"compatibility_date": "2025-09-13",
	"compatibility_flags": ["global_fetch_strictly_public", "nodejs_als"],
	"observability": {
		"enabled": true
	},
	"version_metadata": {
		"binding": "CF_VERSION_METADATA"
	},
	"durable_objects": {
		"bindings": [{ "name": "STATE_STORE", "class_name": "StateStore" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["StateStore"] }],
	"vars": {
		"environment": "production"
	},
	"env": {
		"local": {
			"vars": {
				"environment": "local"
			}
		}
	}
}
